# Android/IntelliJ
#
build/
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
.kotlin/

# node.js
#
node_modules/
npm-debug.log
yarn-error.log

# fastlane
#
# It is recommended to not store the screenshots in the git repo. Instead, use fastlane to re-generate the
# screenshots whenever they are needed.
# For more information about the recommended setup visit:
# https://docs.fastlane.tools/best-practices/source-control/

**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# Bundle artifact
*.jsbundle

# Ruby / CocoaPods
**/Pods/
/vendor/bundle/

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# testing
/coverage

# webpack web build output
/dist-web/

# Local state `wrangler dev` writes beside the config — miniflare's cache SQLite and
# its temp esbuild bundles. Regenerated on every run.
/.wrangler/

# Firebase config (FCM push notifications) — identifies the Firebase project per-developer/
# per-environment; each dev drops their own in from the Firebase console rather than committing
# a shared one.
/android/app/google-services.json
/ios/PrabandhOS/GoogleService-Info.plist

# Yarn
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# .NET backend secrets — real DB connection strings / JWT secrets live here,
# never commit them.
backend/CafePOS.Api/appsettings.Development.json
backend/CafePOS.Api/appsettings.*.local.json
backend/CafePOS.Api/bin/
backend/CafePOS.Api/obj/

# Data Protection keys — decrypt QR tokens; never commit.
backend/CafePOS.Api/keys/

# Ad-hoc debug/test artifacts from local dev sessions (screenshots, DOM dumps,
# process logs) — never meant to be committed, just scratch output.
/dom_dump*.html
/edge_stderr*.log
/emulator_screenshot*.png
/restart*.png
/run*.png
/s[0-9]*.png
/v[0-9]*.png
/web_screenshot*.png
/lc.txt
/logcat.txt
/metro.log
/web.log
